# Variáveis de ambiente do projeto — copie para `.env` e ajuste localmente.
# O `.env` real não entra no git (ver .gitignore); o config.py (pydantic-settings) lê
# este arquivo automaticamente. Todos os valores abaixo são os padrões: o projeto roda
# sem `.env` nenhum — crie um só quando precisar divergir.

# ---------- Caminhos de artefatos ----------
# Diretórios de dados, modelos e métricas, relativos à raiz do projeto.
TRIAGEM_DATA_DIR=data
TRIAGEM_MODELS_DIR=models
TRIAGEM_METRICS_DIR=metrics

# ---------- Modelo servido ----------
TRIAGEM_MODEL_FILENAME=model.joblib
# Backend de inferência da API (ver src/triagem/inference/factory.py).
TRIAGEM_MODEL_BACKEND=sklearn
TRIAGEM_MODEL_VERSION=1.0.0

# ---------- Treino ----------
# Piso de f1-macro para promover um modelo recém-treinado (gate de qualidade).
TRIAGEM_MIN_F1_MACRO=0.53
# Piso de recall na prioridade "alta" (cardiovascular + nervous system) — a métrica de
# negócio da triagem, não só a técnica (ver "Gate de qualidade" no README).
TRIAGEM_MIN_PRIORITY_RECALL_ALTA=0.72
TRIAGEM_RANDOM_SEED=42
TRIAGEM_VALIDATION_SIZE=0.2
